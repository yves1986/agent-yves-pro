# Exemple de fichier .env - copiez-le en .env et ne committez jamais de vraies clés
# Clé API Claude : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Modèle Claude (facultatif) - claude-haiku-5-5 coûte beaucoup moins cher
CLAUDE_MODEL=claude-opus-5-5
CONTACT_PHONE=0505730455
# Numéro qui reçoit les notifications de commande (format local ou international)
MY_PERSONAL_NUMBER=0778602977
CATALOG_LINK=https://wa.me/c/22505730455

# --- Mode WhatsApp Cloud (Vercel) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
ADMIN_TOKEN=
# Upstash Redis (ajoutées automatiquement par l'intégration Vercel)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Mode WhatsApp Web (npm start) ---
PORT=3000
